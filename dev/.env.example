# Host ports for the two local-only WordPress targets.
STAGING_PORT=8088
PRODUCTION_PORT=8089

# The bootstrap script creates this local administrator in both containers.
WP_ADMIN_USER=pagecraft
WP_ADMIN_PASSWORD=pagecraft-dev
WP_ADMIN_EMAIL=pagecraft@example.test

# Set to 0 to install only native WordPress fixtures.
PAGECRAFT_INSTALL_RELEASE_FIXTURE=1

# Set to 0 while developing the theme without Pagecraft Connector.
PAGECRAFT_ACTIVATE_CONNECTOR=1

# Pinned releases whose published requirements include WordPress 6.6 / PHP 8.1.
YOAST_VERSION=23.5
RANK_MATH_VERSION=1.0.225

# Set to 0 to skip downloading and exercising the SEO compatibility matrix.
PAGECRAFT_RUN_SEO_MATRIX=1
