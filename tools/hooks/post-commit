#!/bin/sh
# Says so when a commit changes the published builder but the live Artifact still shows the old
# one. Tracked, and installed with `npm run hooks` — .git/hooks is not tracked, so a clone gets
# this only by asking for it.
#
# post-commit cannot fail a commit and should not try: the commit has happened. This prints, at
# the one moment the omission is fresh enough to act on.
#
# ## It was broken, and that is why the Artifact went stale
#
# Every path here used to be prefixed `page-builder/`, from when this was a subdirectory of
# another repository. After the split nothing matched, the hook exited 0 on every commit, and
# the live copy drifted thirty commits behind — which is the exact failure it exists to prevent.
# A silent filter is the fragile part of a hook, so this one now watches the single file whose
# hash pubcheck actually compares.
touched=$(git diff-tree --no-commit-id --name-only -r HEAD 2>/dev/null)
case "$touched" in
  *dist/artifact.html*) ;;
  *) exit 0 ;;
esac
root=$(git rev-parse --show-toplevel)
[ -f "$root/tools/pubcheck.mjs" ] || exit 0
node "$root/tools/pubcheck.mjs" --hook
exit 0
