{
  "name": "pagecraft",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "Visual page builder that exports static HTML",
  "scripts": {
    "build:form-controls": "node tools/build-public-form-controls.mjs",
    "dev": "vite",
    "build": "node build.mjs",
    "build:editor-package": "node packages/editor/build.mjs",
    "build:next": "vite build",
    "template": "node tools/premade-sites.ts",
    "template:legacy": "node tools/build-premade-sites.ts",
    "test": "node tools/test-editor-build-order.mjs && tsc --noEmit && vitest run",
    "typecheck": "tsc --noEmit",
    "serve": "python3 -m http.server 4877",
    "smoke": "node tools/smoke.mjs",
    "local": "node tools/local-app.mjs",
    "local:stop": "supabase stop"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.7",
    "@modelcontextprotocol/client": "^2.2.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@hono/node-server": "1.19.17",
    "@internationalized/date": "3.12.4",
    "@modelcontextprotocol/server": "^2.0.0",
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "@tanstack/table-core": "9.2.8",
    "@zag-js/date-picker": "1.46.0",
    "@zag-js/vanilla": "1.46.0",
    "echarts": "6.1.0",
    "hono": "4.13.11",
    "nodemailer": "10.0.9",
    "pg": "8.23.0",
    "preact": "^10.29.8",
    "sanitize-html": "2.17.7",
    "sharp": "0.35.5",
    "svgo": "4.1.0",
    "zod": "^4.5.4"
  },
  "type": "module",
  "workspaces": [
    "server",
    "packages/editor"
  ]
}
