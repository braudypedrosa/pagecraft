{
  "name": "pagecraft",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "Visual page builder that exports static HTML",
  "scripts": {
    "dev": "vite",
    "build": "node build.mjs",
    "build:next": "vite build",
    "test": "node build.mjs && tsc --noEmit && vitest run",
    "typecheck": "tsc --noEmit",
    "serve": "python3 -m http.server 4877",
    "publish:check": "node tools/pubcheck.mjs",
    "publish:stamp": "node tools/pubcheck.mjs stamp",
    "hooks": "node tools/install-hooks.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.7",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "type": "module",
  "workspaces": [
    "server"
  ]
}
