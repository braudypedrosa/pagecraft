+++ b/tests/wordpress-font-loader.test.mjs
@@ -0,0 +1,24 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { wordpressFontLoader } from '../tools/wordpress-font-loader.mjs';
+
+test('native font loading caches by selection and retries failures without stale acceptance', async () => {
+  let href = '', requests = 0, ok = true;
+  const load = new Function('gfontsHref', 'fetch', 'parseFontCss', 'fontFaceCss',
+    wordpressFontLoader + '; return wordpressFontCss;')(
+    () => href,
+    async () => { requests++; return { ok, text: async () => href }; },
+    text => [{url: text + '.woff2'}],
+    (faces, url) => '@font-face{src:url(' + url(faces[0]) + ')}');
+  assert.equal(await load(), '');
+  assert.equal(requests, 0);
+  href = 'font-a';
+  assert.match(await load(), /font-a.woff2/);
+  await load();
+  assert.equal(requests, 1);
+  href = 'font-b'; ok = false;
+  await assert.rejects(load(), /retry saving/);
+  ok = true;
+  assert.match(await load(), /font-b.woff2/);
+  assert.equal(requests, 3);
+});
