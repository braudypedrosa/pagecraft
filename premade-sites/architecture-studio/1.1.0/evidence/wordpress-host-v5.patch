diff --git a/tools/wordpress-font-loader.mjs b/tools/wordpress-font-loader.mjs
new file mode 100644
index 0000000..5083f86
--- /dev/null
+++ b/tools/wordpress-font-loader.mjs
@@ -0,0 +1,17 @@
+// Uses the pinned editor's native catalog, parser and font-face compiler.
+// No template-specific family names or user-authored head markup are involved.
+export const wordpressFontLoader = String.raw`
+let wordpressFontCache = { href: '', css: '' };
+async function wordpressFontCss() {
+  const href = gfontsHref();
+  if (!href) return '';
+  if (wordpressFontCache.href === href) return wordpressFontCache.css;
+  const response = await fetch(href);
+  if (!response.ok) throw new Error('The selected fonts could not be loaded. Please retry saving.');
+  const faces = parseFontCss(await response.text());
+  if (!faces.length) throw new Error('The selected fonts returned no usable font files. Please retry saving.');
+  const css = fontFaceCss(faces, face => face.url) + '\n';
+  wordpressFontCache = { href, css };
+  return css;
+}
+`;
diff --git a/tests/wordpress-font-loader.test.mjs b/tests/wordpress-font-loader.test.mjs
