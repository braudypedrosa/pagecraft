          "bodyHtml": "<section id=\"pc-matrix-section\" class=\"pagecraft-section pagecraft--golden-section golden-section\"><div class=\"pagecraft-container\"><div id=\"pc-matrix-row\" class=\"pagecraft-row pagecraft--golden-row golden-row\"><div id=\"pc-matrix-column\" class=\"pagecraft-column pagecraft--golden-column golden-column\"><h1 id=\"pc-matrix-heading\" bp-duration=\"0.8s\" bp-delay=\"0.1s\" bp-easing=\"ease-out\" bp-animation-once=\"true\" class=\"pagecraft-heading pagecraft--golden-heading ts-title bp-animate pc-fade-up golden-heading\"><a href=\"/\">Every real Pagecraft component</a></h1><div id=\"pc-matrix-text\" class=\"pagecraft-wysiwyg pagecraft--golden-text ts-body golden-text\"><p>Rendered by Core with clean, portable content.</p></div><figure id=\"pc-matrix-quote\" class=\"pagecraft-quote pagecraft--golden-quote ts-lead golden-quote\"><blockquote cite=\"https://example.com/\"><p>Portability is a product feature.</p></blockquote><figcaption class=\"pagecraft-attrib\"><a href=\"https://example.com/\">Pagecraft</a></figcaption></figure><figure id=\"pc-matrix-image\" class=\"pagecraft-figure pagecraft--golden-image golden-image\"><a href=\"/\"><img src=\"pc-asset://assethero\" alt=\"Golden component fixture\" width=\"1\" height=\"1\" class=\"pagecraft-image\"></a><figcaption class=\"pagecraft-caption\">A signed raster asset</figcaption></figure><div id=\"pc-matrix-gallery\" class=\"pagecraft-gallery pagecraft-gallery-fixed pagecraft--golden-gallery golden-gallery\" data-lightbox style=\"--g-ratio:4 / 3;--g-fit:cover\"><figure class=\"pagecraft-gallery-item\"><a class=\"pagecraft-gallery-frame\" href=\"pc-asset://assethero\" data-lb=\"0\" aria-label=\"Golden gallery tile\"><img src=\"pc-asset://assethero\" alt=\"Golden gallery tile\" width=\"1\" height=\"1\" loading=\"lazy\" decoding=\"async\" class=\"pagecraft-gallery-img\"></a><figcaption class=\"pagecraft-gallery-caption\">CMS-ready media</figcaption></figure></div><div id=\"pc-matrix-video\" cla