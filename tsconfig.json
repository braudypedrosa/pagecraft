{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    /* `node` is not optional: build.mjs, tools/ and both test files import node: builtins,
       and an explicit `types` array means @types/node is otherwise never loaded. This was
       resolving from an unrelated parent repo's node_modules until this became its own. */
    "types": ["vite/client", "node"],

    /* The server runs on Node's own type stripping, and Node's ESM resolver wants a real
       specifier — `./app` is not a file. So its imports carry `.ts`, which TypeScript only
       permits with this flag. Vitest resolved the extensionless form happily, which is how
       a server that could not boot passed 16 tests. */
    "allowImportingTsExtensions": true,

    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["app/src", "server", "tests", "vite.config.ts"]
}
